{
  "name": "@baduk-history/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "build:components": "npm --prefix src/components run build",
    "pack:components": "npm --prefix src/components run pack:check",
    "start:prod": "node dist/main.js",
    "start:video-scan-worker": "node dist/video-scan-worker.js",
    "start:video-cleanup-worker": "node dist/video-cleanup-worker.js",
    "start:hls-transcode-worker": "node dist/hls-transcode-worker.js",
    "preflight:production": "node dist/production-preflight.js",
    "smoke:hls-transcode": "node scripts/hls-transcode-smoke.mjs",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "node scripts/require-database-url.mjs && prisma migrate dev",
    "db:deploy": "node scripts/require-database-url.mjs && prisma migrate deploy",
    "db:studio": "node scripts/require-database-url.mjs && prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/cloudfront-signer": "^3.1116.0",
    "@aws-sdk/s3-presigned-post": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "jose": "^6.2.10",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
