generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AgeBand {
  UNKNOWN
  UNDER_14
  AGE_14_TO_18
  ADULT
}

enum MinorAccountStatus {
  AGE_DECLARATION_REQUIRED
  GUARDIAN_CONSENT_PENDING
  ACTIVE
  NOT_APPLICABLE
}

enum AccountTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum OAuthAttemptPurpose {
  LOGIN
  LINK
  DELETE_ACCOUNT
}

enum RoleType {
  STUDENT
  GUARDIAN
  INSTRUCTOR
  ORGANIZATION_ADMIN
  OPERATOR
  ADMIN
}

enum RoleVerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  REVOKED
}

enum OrganizationMembershipRole {
  INSTRUCTOR
  ADMIN
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum OrganizationClassStatus {
  ACTIVE
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum GuardianLinkStatus {
  ACTIVE
  REVOKED
}

enum ConsentStatus {
  ACTIVE
  WITHDRAWN
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonQrCodeStatus {
  ACTIVE
  DISABLED
}

enum LessonAssetKind {
  THUMBNAIL
  MATERIAL
}

enum LessonAssetStatus {
  QUARANTINED
  READY
  REJECTED
}

enum LessonVideoAssetStatus {
  UPLOADING
  QUARANTINED
  SCANNING
  READY
  REJECTED
  ERROR
  PURGED
}

enum ObjectDeletionJobStatus {
  PENDING
  DELETING
  COMPLETED
  CANCELLED
  ERROR
}

enum HlsTranscodeJobStatus {
  PENDING
  TRANSCODING
  READY
  SUPERSEDED
  ERROR
}

enum LessonStepType {
  HISTORY_STORY
  BADUK_CONCEPT
  BADUK_MISSION
  HISTORY_MISSION
  REFLECTION
  REWARD
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionPaymentStatus {
  PAID
  CANCELED
  REFUNDED
}

enum SubscriptionOrderStatus {
  PENDING
  PAID
  CANCELED
  FAILED
}

enum StoreOrderStatus {
  PENDING
  PAID
  CANCELED
  FAILED
}

enum SubscriptionRefundStatus {
  COMPLETED
}

enum BadukMissionStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MissionAttemptStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum MissionMoveActor {
  PLAYER
  OPPONENT
}

enum MissionMoveResult {
  CORRECT
  ACCEPTABLE
  INCORRECT
  FORBIDDEN
  ILLEGAL
  TIMEOUT
}

enum RewardType {
  STAR
  BADGE
  ARTIFACT_CARD
}

enum ConsultationStatus {
  SUBMITTED
  IN_REVIEW
  CONTACTED
  CLOSED
}

enum InquiryStatus {
  SUBMITTED
  IN_REVIEW
  ANSWERED
  CLOSED
}

enum InquiryNotificationStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  ERROR
  BOUNCED
}

enum AccountMailKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AccountMailStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  ERROR
  BOUNCED
}

enum UserNotificationKind {
  INQUIRY_ANSWERED
}

enum InquiryAttachmentStatus {
  QUARANTINED
  READY
  REJECTED
}

enum EditorialContentType {
  NOTICE
  FAQ
}

enum EditorialContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommunityPostType {
  CLASS_TIP
  TRAVEL
}

enum CommunityPostStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  HIDDEN
  ARCHIVED
}

enum CommunityReportReason {
  SPAM
  PERSONAL_INFO
  HARASSMENT
  ILLEGAL
  COPYRIGHT
  OTHER
}

enum CommunityReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CommunityReportResolution {
  HIDDEN
  DISMISSED
}

enum CommunityAttachmentKind {
  MATERIAL
  PHOTO
}

enum CommunityAttachmentStatus {
  QUARANTINED
  READY
  REJECTED
}

enum TeachingMaterialAccess {
  PUBLIC
  SUBSCRIBER
  INSTRUCTOR
  ORGANIZATION
}

enum TeachingMaterialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TeachingMaterialAssetStatus {
  QUARANTINED
  READY
  REJECTED
}

enum ClassHelperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ClassHelperAssetKind {
  PROJECTOR_PPT
  ACTIVITY_PDF
  HISTORY_QUIZ
  PROBLEM_MISSION
  ANSWER
  TEACHER_GUIDE
}

enum ClassHelperAssetStatus {
  QUARANTINED
  READY
  REJECTED
}

model User {
  id                            String                   @id @default(uuid()) @db.Uuid
  email                         String?                  @unique
  displayName                   String
  passwordHash                  String?
  emailVerifiedAt               DateTime?
  status                        AccountStatus            @default(ACTIVE)
  ageBand                       AgeBand                  @default(ADULT)
  minorAccountStatus            MinorAccountStatus       @default(NOT_APPLICABLE)
  guardianConsentVerifiedAt     DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  deletedAt                     DateTime?
  roles                         UserRoleAssignment[]
  oauthAccounts                 OAuthAccount[]
  oauthLoginAttempts            OAuthLoginAttempt[]
  sessions                      Session[]
  accountTokens                 AccountToken[]
  guardianInvitations           GuardianInvitation[]     @relation("InvitationStudent")
  studentLinks                  GuardianLink[]           @relation("StudentGuardianLinks")
  guardianLinks                 GuardianLink[]           @relation("GuardianStudentLinks")
  studentConsents               GuardianConsent[]        @relation("StudentGuardianConsents")
  guardianConsents              GuardianConsent[]        @relation("GuardianUserConsents")
  subscriptions                 AccountSubscription[]
  subscriptionOrders            SubscriptionOrder[]
  storeOrders                   StoreOrder[]
  storeCartItems                StoreCartItem[]
  requestedRefunds              SubscriptionRefund[]     @relation("RefundRequester")
  lessonProgress                LessonProgress[]
  auditLogs                     AuditLog[]               @relation("AuditActor")
  createdMissions               BadukMission[]           @relation("MissionCreatedBy")
  updatedMissions               BadukMission[]           @relation("MissionUpdatedBy")
  publishedMissions             BadukMission[]           @relation("MissionPublishedBy")
  missionAttempts               MissionAttempt[]
  rewardGrants                  RewardGrant[]
  missionFavorites              MissionFavorite[]
  consultations                 Consultation[]
  inquiries                     Inquiry[]                @relation("InquiryRequester")
  answeredInquiries             Inquiry[]                @relation("InquiryAnswerer")
  inquiryNotifications          InquiryNotificationJob[] @relation("InquiryNotificationRecipient")
  requestedInquiryNotifications InquiryNotificationJob[] @relation("InquiryNotificationRequester")
  notifications                 UserNotification[]
  inquiryAttachments            InquiryAttachment[]
  createdEditorialContents      EditorialContent[]       @relation("EditorialContentCreatedBy")
  updatedEditorialContents      EditorialContent[]       @relation("EditorialContentUpdatedBy")
  communityPosts                CommunityPost[]          @relation("CommunityPostAuthor")
  reviewedCommunityPosts        CommunityPost[]          @relation("CommunityPostReviewer")
  communityReports              CommunityPostReport[]    @relation("CommunityReportReporter")
  resolvedCommunityReports      CommunityPostReport[]    @relation("CommunityReportResolver")
  communityAttachments          CommunityAttachment[]
  createdTeachingMaterials      TeachingMaterial[]       @relation("TeachingMaterialCreatedBy")
  updatedTeachingMaterials      TeachingMaterial[]       @relation("TeachingMaterialUpdatedBy")
  teachingMaterialAssets        TeachingMaterialAsset[]
  teachingMaterialRevisions     TeachingMaterialRevision[] @relation("TeachingMaterialRevisionChangedBy")
  createdClassHelpers           ClassHelper[]             @relation("ClassHelperCreatedBy")
  updatedClassHelpers           ClassHelper[]             @relation("ClassHelperUpdatedBy")
  classHelperAssets             ClassHelperAsset[]
  classHelperRevisions          ClassHelperRevision[]      @relation("ClassHelperRevisionChangedBy")
  organizationMemberships       OrganizationMembership[]
  organizationClassEnrollments  OrganizationClassEnrollment[]

  @@index([status])
  @@index([minorAccountStatus])
}

model AccountToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  purpose    AccountTokenPurpose
  tokenHash  String              @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailJob    AccountMailJob?

  @@index([userId, purpose, expiresAt])
}

model AccountMailJob {
  id             String            @id @default(uuid()) @db.Uuid
  tokenId        String            @unique @db.Uuid
  kind           AccountMailKind
  encryptedToken String?           @db.Text
  status         AccountMailStatus @default(PENDING)
  attempts       Int               @default(0)
  nextAttemptAt  DateTime          @default(now())
  lockedAt       DateTime?
  completedAt    DateTime?
  messageId      String?           @db.VarChar(255)
  lastError      String?           @db.VarChar(100)
  requestId      String?           @db.VarChar(100)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  token          AccountToken      @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([messageId])
}

model UserRoleAssignment {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  role               RoleType
  verificationStatus RoleVerificationStatus @default(NOT_REQUIRED)
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@index([role, verificationStatus])
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(120)
  slug        String                   @unique @db.VarChar(80)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  classes     OrganizationClass[]
}

model OrganizationMembership {
  id                 String                       @id @default(uuid()) @db.Uuid
  organizationId     String                       @db.Uuid
  userId             String                       @db.Uuid
  role               OrganizationMembershipRole
  status             OrganizationMembershipStatus @default(ACTIVE)
  startsAt           DateTime                     @default(now())
  endsAt             DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherAssignments OrganizationClassTeacherAssignment[]

  @@unique([organizationId, userId])
  @@index([userId, status, startsAt, endsAt])
  @@index([organizationId, role, status])
}

model OrganizationClass {
  id                 String                               @id @default(uuid()) @db.Uuid
  organizationId     String                               @db.Uuid
  name               String                               @db.VarChar(100)
  academicYear       Int
  status             OrganizationClassStatus              @default(ACTIVE)
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt
  organization       Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacherAssignments OrganizationClassTeacherAssignment[]
  enrollments        OrganizationClassEnrollment[]

  @@unique([organizationId, academicYear, name])
  @@index([organizationId, status])
}

model OrganizationClassTeacherAssignment {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationClassId String                 @db.Uuid
  teacherMembershipId String                 @db.Uuid
  startsAt            DateTime               @default(now())
  endsAt              DateTime?
  createdAt           DateTime               @default(now())
  organizationClass   OrganizationClass      @relation(fields: [organizationClassId], references: [id], onDelete: Cascade)
  teacherMembership   OrganizationMembership @relation(fields: [teacherMembershipId], references: [id], onDelete: Cascade)

  @@unique([organizationClassId, teacherMembershipId])
  @@index([teacherMembershipId, startsAt, endsAt])
}

model OrganizationClassEnrollment {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationClassId String            @db.Uuid
  studentId           String            @db.Uuid
  startsAt            DateTime          @default(now())
  endsAt              DateTime?
  createdAt           DateTime          @default(now())
  organizationClass   OrganizationClass @relation(fields: [organizationClassId], references: [id], onDelete: Cascade)
  student             User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([organizationClassId, studentId])
  @@index([studentId, startsAt, endsAt])
}

model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
}

model OAuthLoginAttempt {
  id           String              @id @default(uuid()) @db.Uuid
  provider     String
  purpose      OAuthAttemptPurpose @default(LOGIN)
  userId       String?             @db.Uuid
  stateHash    String              @unique
  nonce        String
  codeVerifier String
  returnTo     String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime            @default(now())
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, consumedAt])
  @@index([userId, purpose, expiresAt])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model GuardianInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  studentId    String           @db.Uuid
  inviteeEmail String?
  inviteePhone String?
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  student      User             @relation("InvitationStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([expiresAt])
}

model GuardianLink {
  id             String             @id @default(uuid()) @db.Uuid
  studentId      String             @db.Uuid
  guardianId     String             @db.Uuid
  status         GuardianLinkStatus @default(ACTIVE)
  consentVersion String?
  consentedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  student        User               @relation("StudentGuardianLinks", fields: [studentId], references: [id], onDelete: Cascade)
  guardian       User               @relation("GuardianStudentLinks", fields: [guardianId], references: [id], onDelete: Cascade)
  consents       GuardianConsent[]

  @@unique([studentId, guardianId])
  @@index([guardianId, status])
}

model GuardianConsent {
  id                 String        @id @default(uuid()) @db.Uuid
  guardianLinkId     String        @db.Uuid
  studentId          String        @db.Uuid
  guardianId         String        @db.Uuid
  consentType        String
  policyVersion      String
  scope              String[]
  verificationMethod String
  status             ConsentStatus @default(ACTIVE)
  requestedAt        DateTime      @default(now())
  consentedAt        DateTime
  withdrawnAt        DateTime?
  auditMetadata      Json?
  guardianLink       GuardianLink  @relation(fields: [guardianLinkId], references: [id], onDelete: Cascade)
  student            User          @relation("StudentGuardianConsents", fields: [studentId], references: [id], onDelete: Cascade)
  guardian           User          @relation("GuardianUserConsents", fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianLinkId, status])
  @@index([studentId, guardianId])
  @@index([guardianId, status])
}

model Era {
  id          String         @id @db.VarChar(40)
  order       Int            @unique
  name        String
  theme       String
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lessons     Lesson[]
  missions    BadukMission[]
}

model Lesson {
  id               String             @id @db.VarChar(40)
  eraId            String             @db.VarChar(40)
  order            Int
  level            String
  course           String
  title            String
  summary          String
  instructor       String
  difficulty       String
  durationMinutes  Int
  status           LessonStatus       @default(DRAFT)
  isFreeSample     Boolean            @default(false)
  videoAssetKey    String?
  thumbnailKey     String?
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  era              Era                @relation(fields: [eraId], references: [id], onDelete: Restrict)
  steps            LessonStep[]
  progress         LessonProgress[]
  assets           LessonAsset[]
  videoAssets      LessonVideoAsset[]
  hlsTranscodeJobs HlsTranscodeJob[]
  missions         BadukMission[]
  teachingMaterials TeachingMaterial[]
  classHelpers       ClassHelper[]
  qrCodes            LessonQrCode[]

  @@unique([eraId, order])
  @@index([status, eraId, order])
}

model LessonQrCode {
  id         String             @id @default(uuid()) @db.Uuid
  codeHash   String             @unique @db.VarChar(64)
  lessonId   String             @db.VarChar(40)
  status     LessonQrCodeStatus @default(ACTIVE)
  expiresAt  DateTime?
  maxClaims  Int?
  claimCount Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  lesson     Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, status])
  @@index([status, expiresAt])
}

model LessonAsset {
  id           String            @id @default(uuid()) @db.Uuid
  lessonId     String            @db.VarChar(40)
  kind         LessonAssetKind
  objectKey    String            @unique
  originalName String
  contentType  String
  size         Int
  status       LessonAssetStatus @default(QUARANTINED)
  scanProvider String?
  scanResult   String?
  scannedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lesson       Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, kind, status])
  @@index([status, createdAt])
}

model LessonVideoAsset {
  id               String                 @id @default(uuid()) @db.Uuid
  lessonId         String                 @db.VarChar(40)
  objectKey        String                 @unique
  originalName     String
  contentType      String
  expectedSize     BigInt
  actualSize       BigInt?
  status           LessonVideoAssetStatus @default(UPLOADING)
  scanProvider     String?
  scanResult       String?
  scannedAt        DateTime?
  attachedAt       DateTime?
  attempts         Int                    @default(0)
  nextAttemptAt    DateTime?
  lockedAt         DateTime?
  lastError        String?
  previousAssetKey String?
  requestedById    String?                @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  lesson           Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  hlsTranscodeJob  HlsTranscodeJob?

  @@index([lessonId, createdAt])
  @@index([status, nextAttemptAt, createdAt])
}

model HlsTranscodeJob {
  id              String                @id @default(uuid()) @db.Uuid
  lessonId        String                @db.VarChar(40)
  sourceAssetId   String                @unique @db.Uuid
  sourceObjectKey String
  manifestKey     String?               @unique
  status          HlsTranscodeJobStatus @default(PENDING)
  attempts        Int                   @default(0)
  nextAttemptAt   DateTime              @default(now())
  lockedAt        DateTime?
  completedAt     DateTime?
  lastError       String?
  requestedById   String?               @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  lesson          Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sourceAsset     LessonVideoAsset      @relation(fields: [sourceAssetId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([lessonId, createdAt])
}

model ObjectDeletionJob {
  id            String                  @id @default(uuid()) @db.Uuid
  objectKey     String                  @unique
  reason        String
  resourceType  String
  resourceId    String
  status        ObjectDeletionJobStatus @default(PENDING)
  attempts      Int                     @default(0)
  nextAttemptAt DateTime
  lockedAt      DateTime?
  completedAt   DateTime?
  lastError     String?
  requestedById String?                 @db.Uuid
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status, nextAttemptAt, createdAt])
}

model LessonStep {
  id          String                 @id @db.VarChar(60)
  lessonId    String                 @db.VarChar(40)
  order       Int
  type        LessonStepType
  title       String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completions LessonStepCompletion[]

  @@unique([lessonId, order])
  @@index([lessonId, order])
}

model LessonProgress {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String                 @db.Uuid
  lessonId            String                 @db.VarChar(40)
  status              LessonProgressStatus   @default(IN_PROGRESS)
  lastPositionSeconds Int                    @default(0)
  startedAt           DateTime               @default(now())
  completedAt         DateTime?
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  stepCompletions     LessonStepCompletion[]

  @@unique([userId, lessonId])
  @@index([userId, status])
  @@index([lessonId, status])
}

model LessonStepCompletion {
  id          String         @id @default(uuid()) @db.Uuid
  progressId  String         @db.Uuid
  stepId      String         @db.VarChar(60)
  completedAt DateTime       @default(now())
  progress    LessonProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  step        LessonStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([progressId, stepId])
  @@index([stepId])
}

model SubscriptionPlan {
  id            String                @id @db.VarChar(40)
  label         String
  months        Int
  price         Int
  active        Boolean               @default(true)
  recommended   Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subscriptions AccountSubscription[]
  orders        SubscriptionOrder[]

  @@index([active, months])
}

model SubscriptionOrder {
  id                String                  @id @db.VarChar(80)
  userId            String                  @db.Uuid
  planId            String                  @db.VarChar(40)
  orderName         String
  amount            Int
  planLabelSnapshot String
  monthsSnapshot    Int
  status            SubscriptionOrderStatus @default(PENDING)
  provider          String                  @default("toss-payments")
  providerPaymentId String?                 @unique
  paymentMethod     String?
  paidAt            DateTime?
  refundedAmount    Int                     @default(0)
  refundedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([expiresAt])
}

model StoreProduct {
  id               String           @id @db.VarChar(40)
  name             String
  price            Int
  active           Boolean          @default(true)
  requiresShipping Boolean          @default(true)
  stockQuantity    Int?
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cartItems        StoreCartItem[]
  orderItems       StoreOrderItem[]

  @@index([active, sortOrder])
}

model StoreOrder {
  id                String           @id @db.VarChar(64)
  userId            String           @db.Uuid
  orderName         String
  amount            Int
  status            StoreOrderStatus @default(PENDING)
  provider          String           @default("toss-payments")
  providerPaymentId String?          @unique
  paymentMethod     String?
  paidAt            DateTime?
  refundedAmount    Int              @default(0)
  refundedAt        DateTime?
  recipientName     String?
  recipientPhone    String?          @db.VarChar(30)
  postalCode        String?          @db.VarChar(10)
  addressLine1      String?
  addressLine2      String?
  inventoryReservedAt DateTime?
