# 실제 값은 저장소에 커밋하지 않고 배포 플랫폼의 Secret으로 등록합니다.
API_IMAGE=registry.example.com/baduk-history-api:commit-sha
DATABASE_URL=postgresql://user:password@managed-postgres.example:5432/baduk_history?sslmode=require
CORS_ORIGINS=https://www.example.com
PUBLIC_APP_URL=https://www.example.com
SESSION_COOKIE_NAME=baduk_session
SESSION_TTL_HOURS=168
OAUTH_STATE_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=운영_SMTP_USER
SMTP_PASSWORD=운영_SMTP_PASSWORD
MAIL_FROM="바둑타고 <no-reply@example.com>"
SMTP_CONNECTION_TIMEOUT_MS=10000
NAVER_CLIENT_ID=운영_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=운영_NAVER_CLIENT_SECRET
NAVER_REDIRECT_URI=https://api.example.com/api/v1/auth/oauth/naver/callback
KAKAO_REST_API_KEY=운영_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=운영_KAKAO_CLIENT_SECRET
KAKAO_REDIRECT_URI=https://api.example.com/api/v1/auth/oauth/kakao/callback
GOOGLE_CLIENT_ID=운영_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=운영_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/oauth/google/callback
PREFLIGHT_REQUIRED_OAUTH_PROVIDERS=naver,kakao,google
GUARDIAN_INVITATION_TTL_HOURS=72
PORTONE_V1_REST_API_KEY=운영_REST_API_KEY
PORTONE_V1_REST_API_SECRET=운영_REST_API_SECRET
OBJECT_STORAGE_ENDPOINT=https://s3-compatible.example.com
OBJECT_STORAGE_REGION=ap-northeast-2
OBJECT_STORAGE_BUCKET=baduk-history-private-media
OBJECT_STORAGE_ACCESS_KEY_ID=운영_ACCESS_KEY
OBJECT_STORAGE_SECRET_ACCESS_KEY=운영_SECRET_KEY
OBJECT_STORAGE_FORCE_PATH_STYLE=false
PLAYBACK_CDN_PROVIDER=cloudfront
PLAYBACK_CDN_BASE_URL=https://media.example.com
PLAYBACK_CDN_KEY_PAIR_ID=?댁쁺_CLOUDFRONT_KEY_PAIR_ID
PLAYBACK_CDN_PRIVATE_KEY_BASE64=?댁쁺_CLOUDFRONT_PRIVATE_KEY_BASE64
PREFLIGHT_REQUIRE_CDN=true
PLAYBACK_URL_TTL_SECONDS=300
VIDEO_UPLOAD_URL_TTL_SECONDS=300
VIDEO_UPLOAD_MAX_BYTES=2147483648
LESSON_ASSET_MAX_BYTES=20971520
MALWARE_SCANNER_HOST=clamav.internal
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=30000
VIDEO_SCAN_POLL_INTERVAL_MS=5000
VIDEO_SCAN_MAX_ATTEMPTS=3
VIDEO_SCAN_LOCK_TIMEOUT_MS=7200000
VIDEO_CLEANUP_POLL_INTERVAL_MS=60000
VIDEO_CLEANUP_MAX_ATTEMPTS=5
VIDEO_CLEANUP_LOCK_TIMEOUT_MS=600000
VIDEO_UPLOAD_ABANDONED_AFTER_HOURS=24
VIDEO_REPLACED_RETENTION_HOURS=24
HLS_TRANSCODE_POLL_INTERVAL_MS=5000
HLS_TRANSCODE_MAX_ATTEMPTS=3
HLS_TRANSCODE_LOCK_TIMEOUT_MS=14400000
HLS_SEGMENT_DURATION_SECONDS=6
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
LOG_LEVEL=info

# 테스트·스테이징·운영 Secret은 서로 공유하지 않습니다.
