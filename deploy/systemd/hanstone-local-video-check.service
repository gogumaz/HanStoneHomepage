[Unit]
Description=Hanstone local lesson video storage check
After=local-fs.target
ConditionPathIsDirectory=/var/www/hanstone/media/lessons

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/hanstone/local-video-maintenance.env
ExecStart=/usr/bin/python3 /usr/local/lib/hanstone/local-video-maintenance.py check --source ${LOCAL_VIDEO_SOURCE} --backup-root ${LOCAL_VIDEO_BACKUP_ROOT} --max-bytes ${LOCAL_VIDEO_MAX_BYTES} --warning-free-bytes ${LOCAL_VIDEO_WARNING_FREE_BYTES} --critical-free-bytes ${LOCAL_VIDEO_CRITICAL_FREE_BYTES} --max-backup-age-hours ${LOCAL_VIDEO_MAX_BACKUP_AGE_HOURS}
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/var/www/hanstone/media/lessons /var/backups/hanstone/local-videos
