# PortOne V1 서버 전용 설정 예시
# 이 파일을 portone-v1.server.local.env로 복사한 뒤 실제 값을 입력하세요.
# local 파일은 Git에서 제외됩니다.

PAYMENT_PROVIDER=portone-v1

# PortOne V1 REST API 인증: 서버에서만 사용
PORTONE_V1_REST_API_KEY=운영_REST_API_KEY
PORTONE_V1_REST_API_SECRET=운영_REST_API_SECRET

# 주문 검증 및 결제 요청 설정
PORTONE_V1_USER_CODE=imp_운영_고객사_식별코드
PORTONE_V1_PG_PROVIDER=tosspay
PORTONE_V1_MID=운영_토스페이_MID

# PortOne 콘솔의 결제알림(Webhook) 관리에도 같은 주소를 등록하세요.
PORTONE_V1_WEBHOOK_URL=https://api.example.com/api/v1/payments/portone/webhook

